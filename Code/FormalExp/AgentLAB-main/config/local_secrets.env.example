# Copy this file to local_secrets.env and fill the real key once.
# local_secrets.env is ignored by Git and is loaded automatically.
OPENAI_API_KEY=replace_with_your_real_openai_key

# Optional override. The Qwen3-8B formal profile already defaults to the
# user's ChatAnywhere OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# Alternative for an official OpenAI key when the server needs an HTTPS proxy.
# HTTPS_PROXY=http://proxy-host:proxy-port
# NO_PROXY=127.0.0.1,localhost

# Legacy DeepSeek experiments remain available only through explicit CLI flags.
# DEEPSEEK_API_KEY=replace_with_your_real_deepseek_key
