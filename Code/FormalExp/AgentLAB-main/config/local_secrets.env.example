# Copy this file to local_secrets.env and fill the real key once.
# local_secrets.env is ignored by Git and is loaded automatically.
OPENAI_API_KEY=replace_with_your_real_openai_key

# Optional: only set this when using an approved OpenAI-compatible gateway.
# The official profile otherwise uses https://api.openai.com/v1.
# OPENAI_BASE_URL=https://your-approved-openai-gateway.example/v1

# Legacy DeepSeek experiments remain available only through explicit CLI flags.
# DEEPSEEK_API_KEY=replace_with_your_real_deepseek_key
